{
  "name": "@athena/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Athena's desktop shell: the Tauri window and the 380 px panel (README sections 3.1 and 3.5).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
