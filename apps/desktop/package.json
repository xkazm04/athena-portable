{
  "name": "athena-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shell (README section 3.1, surfaces): one window, a module bar, a page webview per tab, and the module contract every later surface is written against.",
  "scripts": {
    "dev": "vite",
    "dev:inspect": "cross-env ATHENA_INSPECTOR=1 vite",
    "tauri:inspect": "cross-env ATHENA_INSPECTOR=1 tauri dev",
    "tauri:console": "cross-env VITE_ATHENA_UI=console tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "perf": "node scripts/perf-gate.mjs",
    "perf:stage": "node scripts/perf-gate.mjs --scene stage",
    "perf:bell": "node scripts/perf-gate.mjs --scene bell",
    "perf:surface": "node scripts/perf-gate.mjs --scene surface",
    "perf:apps": "node scripts/perf-gate.mjs --scene apps",
    "perf:all": "pnpm perf && pnpm perf:stage && pnpm perf:bell && pnpm perf:surface && pnpm perf:apps",
    "test:e2e": "vitest run --config e2e/vitest.e2e.config.ts"
  },
  "dependencies": {
    "@athena/bridge": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
