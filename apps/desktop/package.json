    "preview": "node scripts/build.mjs && node scripts/serve-preview.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.2",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "jsdom": "^27.0.0",
    "@types/jsdom": "^21.1.7"
  }
}
