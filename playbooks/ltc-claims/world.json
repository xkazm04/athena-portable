    "policy": [
      {
        "rule": "Policy",
        "text": "HM-77310, tax-qualified, issued 2011-03-15; anniversary March 15. Insured: Grace Okafor. Personal representative on file: Adaeze Okafor (durable power of attorney)."
      },
      {
        "rule": "Elimination period",
        "text": "90 service days, once per lifetime, counted 1=7 (one day of care in a calendar week counts as seven). Services during the elimination period count toward it and are not reimbursed."
      },
      {
        "rule": "Home and community care",
        "text": "Actual charges reimbursed up to the daily maximum, applied per calendar day to all home and community charges combined (agency and adult day together). Unused amounts do not carry to another day."
      },
      {
        "rule": "Daily maximum",
        "text": "3% compound inflation rider: $220.00 for service dates through 2026-03-14; $226.60 for service dates from 2026-03-15."
      },
      {
        "rule": "Qualified providers",
        "text": "A licensed home-care agency or a licensed adult day center. Care by a family member (spouse, child, sibling, grandchild, niece or nephew) is not covered, even if paid."
      },
      {
        "rule": "Non-duplication",
        "text": "No benefit for any day the insured is a hospital inpatient, or for services paid by Medicare."
      },
      {
        "rule": "Proof of loss",
        "text": "An invoice must be received within 120 days after the last day of the month of service. Uploads are accepted at any time; there is no weekend extension."
      },
      {
        "rule": "Resubmission",
        "text": "An invoice with status Rejected (returned whole, before adjudication, for missing documentation) may be resubmitted within 180 days of the rejection notice, as a resubmission of the same invoice. Days denied on an EOB are reconsidered only by appeal."
      },
      {
        "rule": "Appeals",
        "text": "A denied or partly denied invoice may be appealed within 120 days of the EOB date."
      },
      {
        "rule": "Home modification",
        "text": "Modifications listed in the Plan of Care; lifetime maximum $2,000; no elimination period; the proof-of-loss rule applies from the month of payment."
      },
      {
        "rule": "Waiver of premium",
        "text": "Premiums due on or after 2026-03-01 are waived. A waived premium already paid is refunded on written request within 12 months of payment."
      }
    ],
