            "eob_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            },
            "documents": {
              "type": "string"
            }
          },
          "says": "Appeal filed on {eob_id}."
        },
        {
          "name": "request_premium_refund",
          "kind": "REACHES_A_PERSON",
