        {
          "name": "read_eob",
          "kind": "READ",
          "description": "An explanation of benefits: what was paid and what was denied, by day, and why.",
          "params": {
            "eob_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "eobs",
            "match": {
              "eob_id": "eob_id"
            },
            "default": {
              "eob_id": ""
            }
          }
        },
        {
          "name": "submit_invoice",
          "kind": "REACHES_A_PERSON",
          "description": "Submit a new invoice for reimbursement: the invoice id, the amount claimed and the documents attached (file names from Downloads). Signed by the personal representative.",
          "params": {
            "invoice_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "documents": {
              "type": "string"
            }
          },
          "says": "Invoice {invoice_id} submitted."
        },
        {
          "name": "resubmit_invoice",
          "kind": "REACHES_A_PERSON",
          "description": "Resubmit a Rejected invoice with the documentation it was missing: the invoice id, the amount claimed and the documents (file names from Downloads).",
          "params": {
            "invoice_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "documents": {
              "type": "string"
            }
          },
          "says": "Invoice {invoice_id} resubmitted."
        },
        {
          "name": "file_appeal",
          "kind": "REACHES_A_PERSON",
          "description": "Appeal days denied on an EOB: the EOB id, the amount appealed, the reason and the documents (file names from Downloads).",
