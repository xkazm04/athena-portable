  "tables": {
    "policy": [
      {
        "topic": "index",
        "text": "Topics: replacement_cost, california, other_structures, contents, proof."
      },
      {
        "topic": "replacement_cost",
        "text": "Dwelling and Other Structures are settled at replacement cost. Until the damaged property is actually repaired or replaced we pay its actual cash value (replacement cost less depreciation). When the work is complete we pay the rest: the lesser of the replacement cost on the estimate or the amount you actually and necessarily spent, less the actual cash value already paid. You must claim this within 180 days of the loss."
      },
      {
        "topic": "california",
        "text": "California amendatory endorsement: where Insurance Code §2051.5(b) gives more time, it applies. You have at least 12 months from our first actual cash value payment to collect the full replacement cost, and 36 months if the loss relates to a declared state of emergency. Extensions of six months are given for good cause."
      },
      {
        "topic": "other_structures",
        "text": "Endorsement HG-OS-ACV: detached sheds, workshops and barns are settled at actual cash value only, and their depreciation is not recoverable. Fences and every other Other Structure keep replacement cost."
      },
      {
        "topic": "contents",
        "text": "Contents are settled at replacement cost. Until an item is replaced we pay its actual cash value; once you buy the replacement after the loss we pay the lesser of its replacement cost or what you paid for the replacement, less the actual cash value already paid. If the replacement cost you less than the cash value already paid, nothing more is owed."
      },
      {
        "topic": "proof",
        "text": "With each request, give the contractor's final invoice and proof of payment, or for contents the receipt for the replacement."
      }
    ],
