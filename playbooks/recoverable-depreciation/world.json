      "tools": [
        {
          "name": "read_policy",
          "kind": "READ",
          "description": "The policy's terms, by topic: replacement_cost, california, other_structures, contents, proof. Omit the topic for the index.",
          "params": {
            "topic": {
              "type": "string"
            }
          },
          "returns": {
            "table": "policy",
            "match": {
              "topic": "topic"
            },
            "default": {
              "topic": "index"
            }
          }
        },
        {
          "name": "list_claims",
          "kind": "READ",
          "description": "Your claims: loss date and cause, whether it relates to a declared state of emergency, the first actual cash value payment, and the state of the depreciation holdback.",
          "params": {},
          "returns": {
            "table": "claims"
          }
        },
        {
          "name": "list_lines",
          "kind": "READ",
          "description": "The adjuster's estimate for one claim, line by line: replacement cost (RCV), depreciation held back, actual cash value (ACV) paid, and whether the depreciation is withheld or released. Paged.",
          "params": {
            "claim_id": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            }
          },
          "returns": {
            "table": "lines",
            "match": {
              "claim_id": "claim_id"
            },
            "require": [
              "claim_id"
            ],
            "page_size": 6
          }
        },
        {
          "name": "list_payments",
          "kind": "READ",
          "description": "Every payment Hearthguard has made on your claims.",
          "params": {},
          "returns": {
            "table": "payments"
          }
        },
        {
          "name": "request_depreciation",
          "kind": "REACHES_A_PERSON",
          "description": "Ask for the depreciation held back on one estimate line, by line id, now that it is repaired or replaced: the amount and the evidence (invoice, payment, receipt).",
          "params": {
            "line_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "evidence": {
              "type": "string"
            }
          },
          "says": "Request received for {line_id}. Your adjuster reviews it within 15 days."
        }
      ],
