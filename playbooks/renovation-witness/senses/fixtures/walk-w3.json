  "transcript": {
    "language": "en",
    "turns": [
      {
        "speaker": "A",
        "start_s": 0.0,
        "end_s": 7.0,
        "text": "Week three walk, recording. Marco, still okay to record?"
      },
      {
        "speaker": "B",
        "start_s": 7.5,
        "end_s": 9.0,
        "text": "Yep."
      },
      {
        "speaker": "B",
        "start_s": 30.0,
        "end_s": 38.0,
        "text": "Cabinets are in, doors are going on today, about fourteen hung so far."
      },
      {
        "speaker": "B",
        "start_s": 58.0,
        "end_s": 66.0,
        "text": "The pendant wiring is in. I'll swap the dimmers for the smart ones for $180, half a day."
      },
      {
        "speaker": "A",
        "start_s": 67.0,
        "end_s": 70.0,
        "text": "Do it."
      },
      {
        "speaker": "A",
        "start_s": 120.0,
        "end_s": 126.0,
        "text": "I'll have the second draw ready by Friday."
      },
      {
        "speaker": "B",
        "start_s": 150.0,
        "end_s": 158.0,
        "text": "We added a nail plate behind the sink, code thing."
      },
      {
        "speaker": "B",
        "start_s": 201.0,
        "end_s": 206.0,
        "text": "Tile goes in Tuesday, two days."
      }
    ]
  }
