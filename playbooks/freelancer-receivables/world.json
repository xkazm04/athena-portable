      "tools": [
        {
          "name": "list_invoices",
          "kind": "READ",
          "description": "Every open or recent invoice: client, amount, completed, sent, status in the books.",
          "params": {},
          "returns": {
            "table": "books_invoices"
          }
        },
        {
          "name": "read_contract",
          "kind": "READ",
          "description": "A client's contract terms: payment terms, scope, credits, signed date.",
          "params": {
            "client": {
              "type": "string"
            }
          },
          "returns": {
            "table": "contracts",
            "match": {
              "client": "client"
            },
            "mode": "words",
            "default": {
              "client": ""
            },
            "fields": [
              "client",
              "signed",
              "terms"
            ]
          }
        }
      ]
    },
