{
  "today": "2026-10-07",
  "apps": [
    {
      "app_id": "insurer",
      "name": "Bluepoint Health member portal",
      "origin": "https://member.bluepoint.example",
      "path": "/claims",
      "view": {
        "view": "Claims and EOBs",
        "member": "Dana Reyes (and 3 dependents)",
        "plan": "Bluepoint PPO 1500, plan year 2026"
      },
      "tools": [
        {
          "name": "read_plan",
          "kind": "READ",
          "description": "Read the plan's rules by topic: deductible, network, surprise_billing, eob, appeals. Omit the topic for all of them.",
          "params": {
            "topic": {
              "type": "string"
            }
          },
          "returns": {
            "table": "plan",
            "match": {
              "topic": "topic"
            }
          }
        },
        {
          "name": "list_claims",
          "kind": "READ",
          "description": "This year's claims: date of service, provider, service, status and what the patient owes. Paged. Open one with read_claim for the full EOB.",
          "params": {
            "status": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            }
          },
          "returns": {
            "table": "claims",
            "match": {
              "status": "status"
            },
            "page_size": 5,
            "fields": [
              "claim_id",
              "dos",
              "provider",
              "service",
              "status",
              "patient_owes_usd"
            ]
          }
        },
        {
          "name": "read_claim",
          "kind": "READ",
          "description": "One claim's EOB in full, by claim id.",
          "params": {
            "claim_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "claims",
            "match": {
              "claim_id": "claim_id"
            },
            "require": [
              "claim_id"
            ]
          }
        },
        {
          "name": "file_appeal",
          "kind": "REACHES_A_PERSON",
          "description": "File an internal appeal of a denied claim, with the reason and the evidence.",
          "params": {
            "claim_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          },
          "says": "Appeal filed for {claim_id}. Bluepoint decides within 30 days."
        }
      ],
      "aliases": [
        "insurance portal",
        "insurer",
        "Bluepoint",
        "member portal"
      ]
    },
    {
      "app_id": "mychart",
      "name": "MyChart (Valley Medical)",
      "origin": "https://mychart.valleymedical.example",
      "path": "/billing",
      "view": {
        "view": "Billing summary",
        "patient": "Dana Reyes",
        "guarantor_account": "44871"
      },
      "tools": [
        {
          "name": "list_bills",
          "kind": "READ",
          "description": "Open statements from Valley Medical Center and VMC Physicians Group: bill id, biller, date of service, amount due. Open one with read_bill for its line items.",
          "params": {},
          "returns": {
            "table": "vmc_bills",
            "fields": [
              "bill_id",
              "biller",
              "dos",
              "amount_due_usd",
              "note"
            ]
          }
        },
        {
          "name": "read_bill",
          "kind": "READ",
          "description": "One statement in full, with its line items, by bill id.",
          "params": {
            "bill_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "vmc_bills",
            "match": {
              "bill_id": "bill_id"
            },
            "require": [
              "bill_id"
            ]
          }
        },
        {
          "name": "list_payments",
          "kind": "READ",
          "description": "Payments made on this account, this year and last.",
          "params": {},
          "returns": {
            "table": "vmc_payments"
          }
        },
        {
          "name": "list_visits",
          "kind": "READ",
          "description": "Visit history with the reason and the clinician's note.",
          "params": {
            "kind": {
              "type": "string"
            }
          },
          "returns": {
            "table": "visits",
            "match": {
              "kind": "kind"
            },
            "mode": "contains"
          }
        },
        {
          "name": "dispute_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Send the billing office a dispute on one statement: the amount you say is wrong and why.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_disputed_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            }
          },
          "says": "Dispute sent on {bill_id}. The statement is on hold while billing reviews it."
        },
        {
          "name": "pay_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Pay a statement from the card on file.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            }
          },
          "says": "Paid {amount_usd} on {bill_id}."
        }
      ],
      "aliases": [
        "MyChart"
      ]
    },
    {
      "app_id": "cedar",
      "name": "Cedar",
      "origin": "https://pay.cedar.example",
      "path": "/statements",
      "view": {
        "view": "Your statements",
        "billers": [
          "Northstar Anesthesia Associates",
          "Lakeside Dermatology"
        ]
      },
      "tools": [
        {
          "name": "list_statements",
          "kind": "READ",
          "description": "Statements from every biller on Cedar, with balance, insurance paid and payments received.",
          "params": {
            "bill_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "cedar_bills",
            "match": {
              "bill_id": "bill_id"
            }
          }
        },
        {
          "name": "dispute_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Dispute a statement with its biller: the amount you say is wrong and why.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_disputed_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            }
          },
          "says": "Dispute sent on {bill_id}."
        },
        {
          "name": "request_refund",
          "kind": "REACHES_A_PERSON",
          "description": "Ask a biller to refund an overpayment to the card or HSA it came from.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            }
          },
          "says": "Refund of {amount_usd} requested on {bill_id}."
        },
        {
          "name": "pay_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Pay a statement from the card on file.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            }
          },
          "says": "Paid {amount_usd} on {bill_id}."
        }
      ],
      "aliases": [
        "Cedar"
      ]
    }
  ],
  "phases": [
    {
      "app": "insurer",
      "message": "My medical bills are a mess. Start here in my insurance portal: go through this year's claims and EOBs and work out what I actually owe each provider, and anything that looks wrong.",
      "nudges": 2
    },
    {
      "app": "mychart",
      "message": "Now I'm in MyChart for Valley Medical. Compare these bills to what the EOBs say. Dispute what's wrong and pay what I genuinely owe.",
      "nudges": 2
    },
    {
      "app": "cedar",
      "message": "This is Cedar, where the anesthesia group and the dermatologist bill me. Same thing here.",
      "nudges": 1
    },
    {
      "app": "insurer",
      "message": "Back in the insurance portal. Appeal any denial that's worth appealing and still in time, with whatever evidence you found.",
      "nudges": 1
    }
  ],
  "tables": {
    "plan": [
      {
        "topic": "deductible",
        "text": "In-network deductible $1,500 per plan year (January 1 to December 31). 2026: met in full on 2026-03-02. 2025: met on 2025-02-14. After the deductible the plan pays 75% of the allowed amount for most services; you pay 25% coinsurance."
      },
      {
        "topic": "network",
        "text": "In network: Valley Medical Center, VMC Physicians Group (Valley Medical's physician billing), Bayview Imaging, Lakeside Dermatology. Out of network: Northstar Anesthesia Associates."
      },
      {
        "topic": "surprise_billing",
        "text": "No Surprises Act: an out-of-network clinician who treats you at an in-network facility may not bill you more than your in-network cost sharing, which is the patient responsibility shown on the EOB. A balance bill above it can be disputed with the clinician."
      },
      {
        "topic": "eob",
        "text": "On a Final EOB, patient responsibility is the most an in-network provider may bill you for that claim. A claim In process is not decided: do not pay or dispute a bill for it until the EOB is final. A Reprocessed EOB replaces the earlier one; if you paid more than the new patient responsibility, ask the provider for a refund."
      },
      {
        "topic": "appeals",
        "text": "Internal appeal: file within 180 days of the denial date, with the reason and supporting records. One internal appeal per denial. External review is available within 4 months of a final internal denial."
      }
    ],
