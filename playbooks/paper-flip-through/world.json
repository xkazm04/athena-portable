{
  "today": "2026-10-26",
  "apps": [
    {
      "app_id": "camera",
      "name": "Phone camera",
      "origin": "https://camera.athena.example",
      "path": "/piles/pile-1",
      "view": {
        "view": "Dad's mail, filmed",
        "pile": "pile-1: one flip-through of the kitchen-table pile, plus three photos",
        "note": "Every value was read twice off the paper. A field marked asked was not read with certainty: ask, never guess."
      },
      "tools": [
        {
          "name": "list_sheets",
          "kind": "READ",
          "description": "The sheets the camera found in the pile and the photos: sheet id, what kind of paper it is, and the frame it was seen best in. Paged. Open one with read_sheet.",
          "params": {
            "doc_type": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            }
          },
          "returns": {
            "table": "sheets",
            "match": {
              "doc_type": "doc_type"
            },
            "page_size": 8,
            "fields": [
              "sheet_id",
              "doc_type",
              "media_id",
              "frame"
            ]
          }
        },
        {
          "name": "read_sheet",
          "kind": "READ",
          "description": "Everything read off one sheet, by sheet id: each field with its value and where on the paper it was read, or status asked when the two reads did not agree.",
          "params": {
            "sheet_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "sheet_fields",
            "match": {
              "sheet_id": "sheet_id"
            },
            "require": [
              "sheet_id"
            ],
            "fields": [
              "field",
              "status",
              "value",
              "confidence",
              "media_id",
              "frame"
            ]
          }
        }
      ],
      "aliases": [
        "camera",
        "the pile",
        "the mail",
        "the paper"
      ]
    },
    {
      "app_id": "plan",
      "name": "Harbor Health member portal",
      "origin": "https://member.harborhealth.example",
      "path": "/claims",
      "view": {
        "view": "Claims and EOBs",
        "member": "Walter Okafor",
        "authorized_representative": "Ruth Okafor (daughter)",
        "plan": "Harbor Health PPO, plan year 2026"
      },
      "tools": [
        {
          "name": "read_plan",
          "kind": "READ",
          "description": "The plan's rules by topic: deductible, network, surprise_billing, eob, appeals, prior_auth. Omit the topic for all of them.",
          "params": {
            "topic": {
              "type": "string"
            }
          },
          "returns": {
            "table": "plan",
            "match": {
              "topic": "topic"
            }
          }
        },
        {
          "name": "list_claims",
          "kind": "READ",
          "description": "This year's claims: date of service, provider, service, status and what the member owes. Paged. Open one with read_claim for the full EOB.",
          "params": {
            "status": {
              "type": "string"
            },
            "page": {
              "type": "integer"
            }
          },
          "returns": {
            "table": "claims",
            "match": {
              "status": "status"
            },
            "page_size": 5,
            "fields": [
              "claim_id",
              "dos",
              "provider",
              "service",
              "status",
              "patient_owes_usd"
            ]
          }
        },
        {
          "name": "read_claim",
          "kind": "READ",
          "description": "One claim's EOB in full, by claim id.",
          "params": {
            "claim_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "claims",
            "match": {
              "claim_id": "claim_id"
            },
            "require": [
              "claim_id"
            ]
          }
        },
        {
          "name": "file_appeal",
          "kind": "REACHES_A_PERSON",
          "description": "File an internal appeal of a denied claim, with the reason and the evidence.",
          "params": {
            "claim_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          },
          "says": "Appeal filed for {claim_id}. Harbor Health decides within 30 days."
        }
      ],
      "aliases": [
        "insurance portal",
        "insurer",
        "Harbor Health",
        "member portal"
      ]
    },
    {
      "app_id": "riverside",
      "name": "Riverside Health guest pay",
      "origin": "https://pay.riversidehealth.example",
      "path": "/guest",
      "view": {
        "view": "Pay or ask about a statement",
        "note": "Enter the statement number printed on the paper bill. Riverside General Hospital and Riverside Physicians Group bill here."
      },
      "tools": [
        {
          "name": "lookup_statement",
          "kind": "READ",
          "description": "One statement by the statement number printed on the bill: biller, date of service, service, amount due, payments and notes.",
          "params": {
            "bill_id": {
              "type": "string"
            }
          },
          "returns": {
            "table": "riverside_statements",
            "match": {
              "bill_id": "bill_id"
            },
            "require": [
              "bill_id"
            ]
          }
        },
        {
          "name": "dispute_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Send the billing office a dispute on one statement: the amount you say is wrong and why.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_disputed_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            }
          },
          "says": "Dispute sent on {bill_id}. The statement is on hold while billing reviews it."
        },
        {
          "name": "request_refund",
          "kind": "REACHES_A_PERSON",
          "description": "Ask the billing office to refund an overpayment to the card it came from.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            }
          },
          "says": "Refund of {amount_usd} requested on {bill_id}."
        },
        {
          "name": "pay_bill",
          "kind": "REACHES_A_PERSON",
          "description": "Pay a statement from the card on file.",
          "params": {
            "bill_id": {
              "type": "string"
            },
            "amount_usd": {
              "type": "number"
            }
          },
          "says": "Paid {amount_usd} on {bill_id}."
        }
      ],
      "aliases": [
        "Riverside",
        "the hospital",
        "guest pay"
      ]
    },
